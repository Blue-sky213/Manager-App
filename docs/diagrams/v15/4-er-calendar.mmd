    int activity_id PK
    text day PK
  }
  OCCURRENCE {
    int id PK
    int activity_id FK
    text day
    text status "planned / done ..."
    text actual_end
    int moved_from FK
  }
  TUTOR_LOG {
    int id PK
    int occurrence_id FK
    int chapter_id FK
    text status
  }
