erDiagram
  CATEGORY |o--o{ ACTIVITY : "หมวด"
  PRESET |o--o{ ACTIVITY : "สร้างจาก"
  SUBJECT |o--o{ ACTIVITY : "คาบ / ติว / สอบ"
  ACTIVITY ||--o{ ACTIVITY_DATE : "วันที่เลือกเอง"
  ACTIVITY ||--o{ OCCURRENCE : "เกิดเป็นครั้ง"
  OCCURRENCE ||--o{ TUTOR_LOG : "บันทึกติว"
  CATEGORY {
    int id PK
    text name
    text color
  }
  PRESET {
    int id PK
    int category_id FK
    text name
  }
  SUBJECT {
    int id PK
    text name
  }
  ACTIVITY {
    int id PK
    int subject_id FK
    int category_id FK
    text name
    text kind "class / tutor / exam / todo"
    text repeat "none / weekly / dates"
    int start_minute
    int duration_min
    text room
  }
